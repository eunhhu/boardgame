{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bgame/core": ["packages/core/src/index.ts"],
      "@bgame/protocol": ["packages/protocol/src/index.ts"],
      "@bgame/auth": ["packages/auth/src/index.ts"],
      "@bgame/room": ["packages/room/src/index.ts"],
      "@bgame/server": ["packages/server/src/index.ts"],
      "@bgame/client": ["packages/client/src/index.ts"],
      "@bgame/ui": ["packages/ui/src/index.tsx"],
      "@bgame/testkit": ["packages/testkit/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "games/**/*.ts", "games/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "templates", ".bgame"]
}
